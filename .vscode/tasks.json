            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "focus": true,
                "panel": "dedicated",
                "clear": false
            },
            "runOptions": {
                "instanceLimit": 1
            }
        },
        {
            "label": "ESP32: upload all files",
            "dependsOrder": "sequence",
            "dependsOn": [
                "ESP32: upload ppg_quality.py",
                "ESP32: upload sx1278.py",
                "ESP32: upload pcb_config.py",
                "ESP32: upload pcb_screen.py",
                "ESP32: upload pcb_sdcard.py",
                "ESP32: upload pcb_runtime.py",
                "ESP32: upload vitals.py",
                "ESP32: upload main.py"
            ],
            "problemMatcher": []
        },
        {
            "label": "ESP32: reset and run",
            "dependsOrder": "sequence",
            "dependsOn": [
                "ESP32: reset",
                "ESP32: run main.py with logs"
            ],
            "problemMatcher": []
        },
        {
            "label": "ESP32: upload then reset",
            "dependsOrder": "sequence",
            "dependsOn": [
                "ESP32: upload all files",
                "ESP32: reset and run"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [],
            "presentation": {
